{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" pre-tool-use --harness=claude"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" operator-commands --harness=claude"
                    }
                ]
            },
            {
                "matcher": "mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" record --harness=claude"
                    }
                ]
            },
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" question --harness=claude"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" stop --harness=claude"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash|Grep|Glob|Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" nudge --harness=claude"
                    }
                ]
            },
            {
                "matcher": "Agent|Task",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" dispatched --harness=claude"
                    }
                ]
            },
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" answers --harness=claude"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/tools/droost/vendor/droost/workflow/bin/droost-guard\" subagent-stop --harness=claude"
                    }
                ]
            }
        ]
    }
}

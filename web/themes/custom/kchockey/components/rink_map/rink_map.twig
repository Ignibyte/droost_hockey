<div{{ attributes.addClass('container', 'mx-auto', 'px-4', 'mt-12') }}>
  <section class="max-w-5xl mx-auto mb-14 bg-card border-2 border-border shadow-xl overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="relative min-h-[320px] bg-muted">
        <iframe
          title="{{ map_title|default(heading) }}"
          src="https://www.google.com/maps?q={{ map_query|url_encode }}&amp;z=10&amp;output=embed"
          class="absolute inset-0 h-full w-full border-0 grayscale-[0.15]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="p-8 md:p-10 flex flex-col justify-center bg-foreground text-background">
        {% if eyebrow %}
          <div class="flex items-center gap-3 text-accent mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
            <span class="text-xs font-bold uppercase tracking-[0.2em]">{{ eyebrow }}</span>
          </div>
        {% endif %}
        <h2 class="text-3xl md:text-4xl font-serif font-bold uppercase tracking-tight text-white mb-4">{{ heading }}</h2>
        {% if text %}
          <p class="text-white/70 leading-relaxed mb-7">{{ text }}</p>
        {% endif %}
        {% if link_label and link_url %}
          <a href="{{ link_url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 self-start bg-accent text-accent-foreground px-5 py-3 font-serif font-bold uppercase tracking-wider text-sm hover:bg-yellow-300 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
            {{ link_label }}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            <span class="sr-only">{{ '(opens in a new tab)'|t }}</span>
          </a>
        {% endif %}
      </div>
    </div>
  </section>
</div>

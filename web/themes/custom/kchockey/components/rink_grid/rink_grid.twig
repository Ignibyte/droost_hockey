{% if layout == 'band' %}
  <div{{ attributes.addClass('grid', 'grid-cols-1', 'md:grid-cols-3', 'gap-6', 'mb-12') }}>{{ items }}</div>
{% else %}
  <div{{ attributes.addClass('container', 'mx-auto', 'px-4', 'pb-24') }}>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">{{ items }}</div>
  </div>
{% endif %}

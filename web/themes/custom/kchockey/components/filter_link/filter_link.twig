{% set attributes = attributes.addClass('px-4', 'py-2', 'text-sm', 'font-bold', 'uppercase', 'tracking-wider', 'transition-all', 'transform', '-skew-x-12', 'border') %}
{% set attributes = active ? attributes.addClass('bg-primary', 'text-primary-foreground', 'border-primary').setAttribute('aria-current', 'page') : attributes.addClass('bg-card', 'text-foreground', 'border-border', 'hover:border-primary/50') %}
<a href="{{ url }}"{{ attributes }}>
  <span class="skew-x-12 inline-block">{{ label }}</span>
</a>

{% set svg = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
<div{{ attributes.addClass('container', 'mx-auto', 'px-4') }}>
  <div class="max-w-5xl mx-auto bg-accent text-accent-foreground p-8 md:p-10 mb-20 relative overflow-hidden">
    <div class="absolute right-[-2rem] top-[-4rem] w-56 h-56 rounded-full border-[20px] border-foreground/10"></div>
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-[1.35fr_0.65fr] gap-8 items-center">
      <div>
        {% if eyebrow %}
          <p class="text-xs font-bold uppercase tracking-[0.2em] opacity-70 mb-4">{{ eyebrow }}</p>
        {% endif %}
        <h2 class="text-3xl md:text-4xl font-serif font-bold uppercase tracking-tight mb-4">{{ heading }}</h2>
        {% if text %}
          <p class="max-w-2xl leading-relaxed opacity-80">{{ text }}</p>
        {% endif %}
      </div>
      <div class="md:border-l md:border-foreground/20 md:pl-8 space-y-4 text-sm font-semibold">
        {% if date %}
          <div class="flex items-center gap-3"><svg {{ svg|raw }} width="18" height="18"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg> {{ date }}</div>
        {% endif %}
        {% if place %}
          <div class="flex items-center gap-3"><svg {{ svg|raw }} width="18" height="18"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg> {{ place }}</div>
        {% endif %}
        {% if audience %}
          <div class="flex items-center gap-3"><svg {{ svg|raw }} width="18" height="18"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg> {{ audience }}</div>
        {% endif %}
        {% if link_label and link_url %}
          <a href="{{ link_url }}" class="inline-flex items-center gap-2 pt-2 font-serif uppercase tracking-wider hover:gap-3 transition-all">{{ link_label }} <svg {{ svg|raw }} width="16" height="16"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<section{{ attributes.addClass('py-20', 'bg-muted/30', 'border-t', 'border-border') }}>
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
      <div>
        <h2 class="text-4xl md:text-5xl font-serif font-bold uppercase tracking-tight text-foreground">{{ heading }}</h2>
        <div class="h-1 w-20 bg-accent mt-4"></div>
      </div>
      {% if link_label and link_url %}
        <a href="{{ link_url }}" class="flex items-center gap-2 font-serif uppercase tracking-wider text-primary hover:text-accent transition-colors font-bold group">
          {{ link_label }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>

    {{ camps }}
  </div>
</section>

{% set tagline_lines = tagline ? tagline|trim|split(' ', 2) : [] %}
<div{{ attributes.addClass('container', 'mx-auto', 'px-4', 'mt-16') }}>
  <section class="max-w-5xl mx-auto mb-16 bg-foreground text-background border-4 border-accent shadow-xl relative overflow-hidden">
    <div class="absolute -right-16 -top-20 w-64 h-64 rounded-full border-[24px] border-accent/20"></div>
    <div class="absolute right-12 bottom-[-5rem] w-52 h-52 rounded-full border-[18px] border-white/5"></div>
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr]">
      <div class="min-h-[260px] bg-accent text-accent-foreground p-8 md:p-10 flex flex-col justify-between">
        {% if eyebrow %}
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em]">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
            {{ eyebrow }}
          </div>
        {% endif %}
        <div>
          {% if kicker %}
            <p class="text-sm font-bold uppercase tracking-widest opacity-70 mb-2">{{ kicker }}</p>
          {% endif %}
          {% if tagline_lines is not empty %}
            <p class="text-5xl md:text-6xl font-serif font-bold uppercase leading-[0.85] tracking-tight">{{ tagline_lines|first }}{% if tagline_lines|length > 1 %}<br>{{ tagline_lines|last }}{% endif %}</p>
          {% endif %}
        </div>
      </div>
      <div class="p-8 md:p-10">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-5">
          <div>
            {% if specialty %}
              <p class="text-accent font-bold uppercase tracking-[0.18em] text-xs mb-2">{{ specialty }}</p>
            {% endif %}
            <h2 class="text-3xl md:text-4xl font-serif font-bold uppercase tracking-tight text-white">{{ name }}</h2>
          </div>
          {% if rate is not null %}
            <div class="shrink-0 text-left sm:text-right">
              {% if rate_label %}
                <p class="text-xs uppercase tracking-widest text-white/50">{{ rate_label }}</p>
              {% endif %}
              <p class="text-2xl font-serif font-bold text-white">${{ rate }}<span class="text-sm font-sans font-normal text-white/60">/hr</span></p>
            </div>
          {% endif %}
        </div>
        {% if bio %}
          <p class="text-white/70 leading-relaxed max-w-2xl mb-6">{{ bio }}</p>
        {% endif %}
        {% if highlights is not empty %}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8 text-sm text-white/80">{{ highlights }}</div>
        {% endif %}
        {% if button_label and button_url %}
          <a href="{{ button_url }}" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring border border-primary-border min-h-9 px-4 py-2 bg-accent text-accent-foreground hover:bg-yellow-300 font-serif uppercase tracking-wider rounded-none transform -skew-x-12">
            <span class="skew-x-12 inline-flex items-center gap-2">{{ button_label }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        {% endif %}
      </div>
    </div>
  </section>
</div>

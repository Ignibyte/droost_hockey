{% set paths = {
  ice: '<path d="M12 17c5 0 8-2.69 8-6H4c0 3.31 3 6 8 6m-4 4h8m-4-3v3M5.14 11a3.5 3.5 0 1 1 6.71 0"/><path d="M12.14 11a3.5 3.5 0 1 1 6.71 0"/><path d="M15.5 6.5a3.5 3.5 0 1 0-7 0"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  sparkles: '<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>',
} %}
<div{{ attributes.addClass('bg-card', 'border', 'border-border', 'p-7', 'relative', 'overflow-hidden', '[counter-increment:first-step]') }}>
  <span class="absolute right-5 top-3 text-6xl font-serif font-bold text-muted/50 before:content-[counter(first-step,decimal-leading-zero)]" data-step-number></span>
  <div class="w-12 h-12 bg-accent/15 text-accent flex items-center justify-center mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ (paths[icon] ?? paths.ice)|raw }}</svg>
  </div>
  <h2 class="text-xl font-serif font-bold uppercase tracking-tight mb-3">{{ title }}</h2>
  {% if text %}
    <p class="text-muted-foreground leading-relaxed text-sm">{{ text }}</p>
  {% endif %}
</div>

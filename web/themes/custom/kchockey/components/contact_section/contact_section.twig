<div{{ attributes.addClass('container', 'mx-auto', 'px-4', 'mt-12', 'pb-24') }}>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 max-w-6xl mx-auto">
    <div class="md:col-span-5 space-y-8">
      {% block aside %}{% endblock %}
    </div>
    <div class="md:col-span-7">
      <div class="kch-contact-form bg-card border border-border p-8 shadow-lg">
        <h2 class="text-2xl font-serif font-bold uppercase tracking-tight text-foreground mb-6">{{ form_heading }}</h2>
        {% block form %}{% endblock %}
      </div>
    </div>
  </div>
</div>

{% set placement = variant|default('desktop') %}
{% if placement == 'desktop' %}
  {% set classes = ['px-3', 'py-2', 'rounded-md', 'text-sm', 'font-medium', 'transition-colors', 'hover:text-accent', active ? 'text-accent' : 'text-muted-foreground', active ? 'bg-accent/10'] %}
{% elseif placement == 'mobile' %}
  {% set classes = ['block', 'px-3', 'py-4', 'text-base', 'font-medium', 'rounded-md', active ? 'text-accent' : 'text-foreground', active ? 'bg-accent/10' : 'hover:bg-muted'] %}
{% elseif placement == 'footer' %}
  {% set classes = ['text-muted/80', 'hover:text-white', 'transition-colors'] %}
{% else %}
  {% set classes = ['hover:text-white', 'transition-colors'] %}
{% endif %}
<a{{ attributes.addClass(classes|filter(c => c)).setAttribute('href', url) }}{% if active %} aria-current="page"{% endif %}>{{ label }}</a>

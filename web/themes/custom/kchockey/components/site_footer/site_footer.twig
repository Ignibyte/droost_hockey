{% set icon = 'xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
<footer{{ attributes.addClass('bg-foreground', 'text-background', 'py-12', 'md:py-16', 'mt-20', 'border-t-4', 'border-accent') }}>
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

      <div class="col-span-1 md:col-span-2">
        <a href="{{ home_url }}" class="inline-flex items-center gap-2 mb-4 group">
          {%- apply spaceless -%}
          <div class="w-8 h-8 bg-accent rounded flex items-center justify-center transform -skew-x-12">
            <span class="font-serif font-bold text-accent-foreground text-xl leading-none">KC</span>
          </div>
          <span class="font-serif text-2xl font-bold tracking-tight uppercase">Hockey</span>
          {%- endapply -%}
        </a>
        {% if blurb %}
          <p class="text-muted/80 max-w-sm mb-6 leading-relaxed">{{ blurb }}</p>
        {% endif %}
        {% if social %}
          <div class="flex items-center gap-4">
            {{ social }}
          </div>
        {% endif %}
      </div>

      <div>
        <h3 class="font-serif text-xl mb-4 text-accent uppercase tracking-wider">{{ 'Explore'|t }}</h3>
        <ul class="space-y-3">
          {% for key, item in explore %}
            {% if (key ~ '')|first != '#' %}
              <li>{{ item }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div>
        <h3 class="font-serif text-xl mb-4 text-accent uppercase tracking-wider">{{ 'Contact'|t }}</h3>
        <ul class="space-y-4">
          {% if location_line_1 or location_line_2 %}
            <li class="flex items-start gap-3 text-muted/80">
              <svg class="shrink-0 mt-0.5 text-accent" {{ icon|raw }}><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{{ location_line_1 }}{% if location_line_1 and location_line_2 %}<br>{% endif %}{{ location_line_2 }}</span>
            </li>
          {% endif %}
          {% if email %}
            <li class="flex items-center gap-3 text-muted/80">
              <svg class="shrink-0 text-accent" {{ icon|raw }}><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href="mailto:{{ email }}" class="hover:text-white transition-colors">{{ email }}</a>
            </li>
          {% endif %}
          {% if phone %}
            <li class="flex items-center gap-3 text-muted/80">
              <svg class="shrink-0 text-accent" {{ icon|raw }}><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href="{{ phone_href }}" class="hover:text-white transition-colors">{{ phone }}</a>
            </li>
          {% endif %}
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-muted/60">
      <p>{{ copyright }}</p>
      <div class="flex gap-4">
        {{ legal }}
      </div>
    </div>
  </div>
</footer>

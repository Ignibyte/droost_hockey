{
  "name": "kchockey",
  "private": true,
  "description": "Build tooling for the KC Hockey theme's stylesheet. The theme runs without it: css/kchockey.css is committed.",
  "scripts": {
    "build": "tailwindcss -i css/src/kchockey.css -o css/kchockey.css --minify",
    "watch": "tailwindcss -i css/src/kchockey.css -o css/kchockey.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/oswald": "5.2.8",
    "@tailwindcss/cli": "4.1.14",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0"
  }
}

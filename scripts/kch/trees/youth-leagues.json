    {
      "uuid": "9b9b4c73-b9dd-45ec-868e-c07a271ce2a2",
      "component_id": "sdc.kchockey.faq_item",
      "parent_uuid": "3dad7ae2-21e1-4d27-b65f-4b91b175bd5e",
      "slot": "items",
      "inputs": {
        "question": "Does my child need prior hockey experience?",
        "answer": "No. Many players begin with learn-to-skate and introductory hockey before joining a league. If your child can skate, stop, and follow a coach's directions, a rink coordinator can usually point you toward the right entry-level program."
      }
    },
    {
      "uuid": "d43de1d1-2d57-49b5-b922-e199832de697",
      "component_id": "sdc.kchockey.faq_item",
      "parent_uuid": "3dad7ae2-21e1-4d27-b65f-4b91b175bd5e",
      "slot": "items",
      "inputs": {
        "question": "How are players placed on teams?",
        "answer": "Most programs use age group and a short evaluation skate to create balanced teams. The goal is to give every player a positive challenge and a chance to contribute, not to create a perfect ranking."
      }
    },
    {
      "uuid": "e6ca9a3f-5346-48ea-bd1a-f4846bbd2e49",
      "component_id": "sdc.kchockey.faq_item",
      "parent_uuid": "3dad7ae2-21e1-4d27-b65f-4b91b175bd5e",
      "slot": "items",
      "inputs": {
        "question": "What does a typical season include?",
        "answer": "A recreational season commonly includes weekly practices, scheduled games, jersey use, and optional tournaments. The exact schedule varies by rink and division, so check the registration details for your preferred facility."
      }
    },
    {
      "uuid": "f46c98f9-b270-4fcb-b66e-cc3a14c80a43",
      "component_id": "sdc.kchockey.faq_item",
      "parent_uuid": "3dad7ae2-21e1-4d27-b65f-4b91b175bd5e",
      "slot": "items",
      "inputs": {
        "question": "Where can I find youth league registration?",
        "answer": "Start with the rink directory to find a facility near you, then use its website or registration desk for current dates and pricing. League calendars change throughout the year, and KCHockey can help you compare options."
      }
    }

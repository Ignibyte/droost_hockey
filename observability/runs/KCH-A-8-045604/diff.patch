+      "slot": "items",
+      "inputs": {
+        "question": "Is hockey safe for kids?",
+        "answer": "Hockey has contact and speed, but youth programs teach body control, awareness, and safe play from day one. Properly fitted equipment, certified coaches, and age-appropriate rules are all part of a strong program. Talk with the coach about your child's experience level and comfort."
+      }
+    },

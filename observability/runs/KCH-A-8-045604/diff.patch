+      "inputs": {
+        "question": "How much does it cost to get started?",
+        "answer": "Introductory classes vary by rink, but most families can try a first session for a modest registration fee. Ask about rental equipment, seasonal packages, and scholarship options before purchasing gear. Our rink directory is a good place to compare programs."
+      }
+    },
+    {
+      "uuid": "c5f656dc-18b0-4699-b09a-d289b6783e3d",
+      "component_id": "sdc.kchockey.faq_item",
